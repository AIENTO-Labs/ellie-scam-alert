{
  "redirects": [
    { "source": "/", "destination": "/app/", "permanent": false },
    { "source": "/live", "destination": "/app/live.html", "permanent": false },
    { "source": "/call", "destination": "/app/call-demo/", "permanent": false },
    { "source": "/ask", "destination": "/app/", "permanent": false }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
      { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
    ] }
  ]
}
